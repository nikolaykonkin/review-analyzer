# Шаблон переменных окружения
# Скопируйте в .env и заполните; .env не коммитится
# Список неполный: переменные добавляются по мере появления в internal/config
# Приложение само .env не читает: переменные нужно передать в окружение
# Пустое значение означает значение по умолчанию

# Порт HTTP-сервера, целое число от 1 до 65535 (по умолчанию 8080)
HTTP_PORT=

# Уровень логирования: debug, info, warn, error (по умолчанию info)
LOG_LEVEL=