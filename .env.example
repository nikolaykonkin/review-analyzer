# Шаблон переменных окружения
# Скопируйте в .env и заполните; .env не коммитится
# Список неполный: переменные добавляются по мере появления в internal/config и docker-compose.yml
# Приложение само .env не читает: Docker Compose подставляет значения из .env в docker-compose.yml,
# а для запуска без Docker переменные нужно передать в окружение (например, set -a; source .env; set +a)
# Пустое значение означает значение по умолчанию, если оно есть
# Пароль в DATABASE_URL и TEST_DATABASE_URL должен совпадать с POSTGRES_PASSWORD
# и не содержать символов, которые нужно экранировать в URL

# --- Сервис (читает internal/config) ---

# Строка подключения к PostgreSQL, обязательна: содержит пароль, не публикуется
DATABASE_URL=postgres://review:change_me@localhost:5433/review_analyzer?sslmode=disable

# Порт HTTP-сервера, целое число от 1 до 65535 (по умолчанию 8080)
HTTP_PORT=

# Уровень логирования: debug, info, warn, error (по умолчанию info)
LOG_LEVEL=

# --- Тесты ---

# Строка подключения для интеграционных тестов (без нее они пропускаются)
# Тесты создают во временной схеме свои таблицы и удаляют их по завершении
TEST_DATABASE_URL=postgres://review:change_me@localhost:5433/review_analyzer?sslmode=disable

# --- Docker Compose (читает docker-compose.yml) ---

POSTGRES_USER=review
POSTGRES_PASSWORD=change_me
POSTGRES_DB=review_analyzer

# Порты на хосте: PostgreSQL и сервис
POSTGRES_HOST_PORT=5433
SERVICE_HOST_PORT=8080