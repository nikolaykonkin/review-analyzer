# Шаблон переменных окружения
# Скопируйте в .env и заполните; .env не коммитится
# Список неполный: переменные добавляются по мере появления в internal/config
# Значения по умолчанию и допустимые значения определяются в internal/config

# Порт HTTP-сервера
HTTP_PORT=

# Уровень логирования
LOG_LEVEL=